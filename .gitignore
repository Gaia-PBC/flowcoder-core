# Ignore everything by default
*

# Allow specific files in commands/ (must un-ignore dir first, contents still ignored by *)
!commands/
!commands/ex0-design-doc.json
!commands/ex1-do-until-done.json
!commands/ex2-testing-loop.json
!commands/ex3-improve-project.json
!commands/all-examples.json

# Allow root level files
!pyproject.toml
!README.md
!uv.lock
!LICENSE

# Allow .gitignore itself
!.gitignore

# Allow .github directory
!.github/
!.github/**

# Allow .python-version
!.python-version

# Allow packages/ directory (vendored Pydantic packages)
!packages/
!packages/**

# Allow tests/ directory
!tests/
!tests/**

# Allow scripts/
!scripts/
!scripts/**

# Allow docker/
!docker/
!docker/**

# Allow design_docs/
!design_docs/
!design_docs/**

# Allow progress-reports/
!progress-reports/
!progress-reports/**

# Ignore Python bytecode everywhere. Must stay last: the !dir/** rules above
# would otherwise re-include it, since the last matching pattern wins.
__pycache__/
*.py[cod]
